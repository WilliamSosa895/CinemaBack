# ==========================================
# Archivo de ejemplo para variables de entorno
# ==========================================
# Copia este archivo a .env y completa con tus valores reales
# Las variables de entorno se deben definir antes de ejecutar la aplicación

# ===================
# AUTENTICACIÓN JWT
# ===================
# Clave secreta para firmar tokens JWT. Debe ser una cadena larga y aleatoria.
# Genera una con: openssl rand -base64 32
API_KEY=your_jwt_secret_key_here

# ===================
# FRONTEND
# ===================
# URL del frontend para configurar CORS. Ejemplo: http://localhost:3000 o https://tudominio.com
URL=http://localhost:3000

# ===================
# BASE DE DATOS PostgreSQL (Aiven)
# ===================
# URL JDBC de conexión a PostgreSQL con SSL
# Formato: jdbc:postgresql://host:puerto/database?sslmode=require
DB_URL=jdbc:postgresql://your-aiven-host:25339/defaultdb?sslmode=require

# Usuario de la base de datos
DB_USER=your_database_user

# Contraseña de la base de datos
DB_PASS=your_database_password

# ===================
# SMTP (Envío de correos)
# ===================
MAIL_FROM=your_sender@example.com
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password

# ===================
# CLOUDINARY (Gestión de imágenes)
# ===================
# Nombre de la nube de Cloudinary
# Obtén en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# API Key de Cloudinary
# Obtén en https://cloudinary.com/console/settings/api-keys
CLOUDINARY_API_KEY=your_cloudinary_api_key

# API Secret de Cloudinary
# Obtén en https://cloudinary.com/console/settings/api-keys
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
