# ==========================================
# .gitignore - Archivos a ignorar en Git
# ==========================================

# ===================
# Variables de Entorno y Propiedades Locales (CRÍTICO)
# ===================
.env
.env.local
.env.*.local
application-dev.properties
application-local.properties

# ===================
# Maven
# ===================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml

# ===================
# IDE - VS Code
# ===================
.vscode/
*.code-workspace
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# ===================
# IDE - IntelliJ IDEA
# ===================
.idea/
*.iml
*.iws
*.ipr
out/
.DS_Store

# ===================
# IDE - Eclipse
# ===================
.classpath
.project
.settings/
bin/

# ===================
# IDE - NetBeans
# ===================
nbproject/
.nb-gradle/

# ===================
# Sistema Operativo
# ===================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================
# Logs
# ===================
*.log
*.log.*
log/
logs/

# ===================
# Aplicación Spring Boot
# ===================
*.jar
*.war
*.rar
*.class
*.properties.bak

# ===================
# Base de Datos Local
# ===================
*.db
*.sqlite
*.h2.db

# ===================
# Node (si tienes frontend integrado)
# ===================
node_modules/
npm-debug.log
yarn-error.log

# ===================
# Otros
# ===================
*.swp
*.swo
*~
.gradle/
